# Backend settings. Copy to backend/.env (or reuse the project-root .env).

# Option A - a single URL (recommended for hosted databases such as Render/Neon/Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/youtube_trending?sslmode=require

# Option B - separate values (same names as the ETL .env):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_trending
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
# DB_SSLMODE=require

# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
